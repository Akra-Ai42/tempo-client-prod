# === LLM Provider (OpenRouter) ===
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://tempo-client-prod.onrender.com
OPENROUTER_APP_NAME=Tempo Client

# === Session cookie ===
SESSION_SECRET=change-me-in-production-this-must-be-a-long-random-string
SESSION_COOKIE_NAME=tempo_session
SESSION_MAX_AGE=86400

# === Base de données ===
DATABASE_URL=sqlite:///./data/tempo.db

# === ML Models ===
CHURN_MODEL_PATH=./models/xgboost_churn.pkl
RECO_MODEL_PATH=./models/reco_model.pkl
SHAP_EXPLAINER_PATH=./models/shap_explainer.pkl

# === Monitoring ===
EVIDENTLY_REPORTS_DIR=./data/evidently_reports
LLM_COST_LOG_PATH=./data/llm_cost_log.jsonl
DRIFT_CHECK_INTERVAL_HOURS=24

# === Scheduler ===
ALERT_CHECK_INTERVAL_MINUTES=60
TIMEZONE=Europe/Paris

# === Divers ===
LOG_LEVEL=INFO
ENVIRONMENT=development
